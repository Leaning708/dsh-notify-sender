{
  "name": "dsh-notify-sender",
  "version": "0.3.3",
  "private": true,
  "type": "module",
  "description": "Bidirectional bridge between DeepSeek Harness and Coopanion over WebSocket: task-completion notifications and reply relay.",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.6",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test test/apply.test.mjs test/client.test.mjs test/notify.test.mjs test/ws-client.test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5",
    "ws": "^8.22.1"
  }
}
